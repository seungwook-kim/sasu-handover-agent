# LLM 연결 방식: openai | claude-code
#   openai:      OpenAI 호환 주소 (개발: OpenRouter / 현장: 사내 LLM 서버)
#   claude-code: 이 PC에 로그인된 claude CLI를 헤드리스로 쓴다 (API 키 불필요, 개발용)
#                SASU_LLM_MODEL은 sonnet(기본) / haiku / opus
SASU_LLM_PROVIDER=openai
SASU_LLM_BASE_URL=https://openrouter.ai/api/v1
SASU_LLM_API_KEY=
SASU_LLM_MODEL=

# 임베딩(벡터 검색): none | local | api
#   local: 작은 다국어 모델을 CPU에서 돌린다 (먼저 uv sync --extra local-embed). 한 번 색인하면 캐시된다.
#   api:   OpenAI 호환 /embeddings 주소. 비우면 LLM 주소·키를 쓴다.
SASU_EMBED_PROVIDER=none
SASU_EMBED_MODEL=
SASU_EMBED_BASE_URL=
SASU_EMBED_API_KEY=

# 분석 결과를 저장할 SQLite 파일
SASU_DB_PATH=data/sasu.db

# 여러 DB용 Mapper XML이 함께 있을 때 분석할 DB 종류 (파일명의 _SQL_<dialect>.xml)
SASU_SQL_DIALECT=oracle
